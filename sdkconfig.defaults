# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# LVGL 使用系统堆而非固定内存池:全部页面启动时一次建好(约 130 个对象),
# 固定 32KB 池实测耗尽(LV_ASSERT_MALLOC 死循环 → 看门狗);改用系统堆后按实际
# 用量占用,且 TLS/音频缓冲与界面共用同一份剩余内存。
CONFIG_LV_USE_CLIB_MALLOC=y
# 网盘授权二维码。
CONFIG_LV_USE_QRCODE=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth ---
# 阿里云盘随身听不使用 BLE(省约 50KB 堆,留给 TLS 与音频缓冲)。
CONFIG_BT_ENABLED=n

# --- 内存(无 PSRAM:下载 TLS + MP3 解码 + 环形缓冲 + 界面共用约 200 KB 内部 RAM) ---
# C3 的 IRAM 与 DRAM 是同一块 SRAM:放进 IRAM 的代码直接减少堆。播放 MP3 只需约
# 16 KB/s 吞吐,不需要 Wi-Fi 收发路径的 IRAM 加速;FreeRTOS 也放回 Flash。
# 实测:不这样做时 CDN 的 TLS 记录缓冲(16.7 KB 连续)分配失败,播放报网络错误。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# --- 网络与 TLS ---
# 动态 TLS 缓冲:按收到的每条 TLS 记录现场分配(静态 16KiB 收缓冲会在握手期挤死
# RSA 验签的临时分配,实测 PK verify failed)。配套把单次响应压小:音频扫描
# ALI_SCAN_LIMIT=4,让列表响应记录 ≤7KB,读阶段分配不至失败。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# 裁掉一切非必需的 TLS 开销:解码器静态池(.bss)与 CDN TLS 握手峰值在 400KB
# DRAM 里零和竞争,24K 池 + TLS1.3 握手实测必挂(esp-aes 分配失败 / PK verify
# 0x4290 / -0x3000 fatal alert)。TLS 降级到 1.2 后改由 bp_ali/bp_player 在每个
# 连接上发 ALPN http/1.1 维持浏览器式指纹,规避阿里 WAF 对"仅 TLS 1.2 + 无 ALPN"
# 连接的风控重置(历史实测:令牌交换握手后被断开 rc=-1)。
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# 接收窗口 5760(4×MSS)在 160kbps 下够用,但 320kbps(40KB/s)时网络 RTT 稍大
# (>140ms)吞吐就低于消费速率,环形缓冲长期攒不起来导致频繁欠载。通告窗口增大
# 到 16KB:实际缓冲仍受现有 PBUF 池/WiFi RX 缓冲(8 个 ≈12.8KB)限制,不新增内存,
# 但有效窗口翻倍,吞吐上限从 ~38KB/s@150ms 提升到 ~85KB/s。
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
